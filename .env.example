# Supabase (browser + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — server only (Stripe webhook writes). Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — server only. Direct-to-driver $2.99 CAD/month (lookup_key fuel_dip_monthly).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Live CAD monthly price
STRIPE_PRICE_ID=price_1TzJ6e13QgrVjwffdpj7y0nD

# Optional absolute origin for Checkout success/cancel URLs (custom domain preferred)
# NEXT_PUBLIC_SITE_URL=https://fuel-dip-calculator.app

# Sentry (public DSN — SDK has a production fallback). Auth token = source maps only.
# NEXT_PUBLIC_SENTRY_DSN=https://ee15ec0c90ebc3e19740d9aeb9d8c6fe@o4511662485405696.ingest.us.sentry.io/4511933067493376
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=detours-mobile
# SENTRY_PROJECT=fuel-dip-calculator

# Resend — emails each in-app feedback to contact@detours-app.com. Save still
